# YYC³ AI小语智能成长守护系统 - 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值

# ===========================================
# 应用基础配置（当前有效）
# ===========================================

# 环境类型
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development

# 应用域名与名称
NEXT_PUBLIC_APP_URL=http://localhost:1228
NEXT_PUBLIC_APP_NAME=YYC³ AI小语智能成长守护系统

# 服务端口（dev/start 脚本固定 1228）
PORT=1228
HOST=0.0.0.0

# 国际化（默认 zh，可选 en）
NEXT_PUBLIC_DEFAULT_LOCALE=zh
NEXT_PUBLIC_LOCALES=zh,en

# ===========================================
# AI 服务配置（当前有效）
# ===========================================

# BigModel API（智谱AI）— 作业批改、语音识别等
# 获取密钥: https://bigmodel.cn/usercenter/proj-mgmt/apikeys
BIGMODEL_API_KEY=your_bigmodel_api_key_here

# ===========================================
# 鉴权配置（P0-1 鉴权中间件）
# ===========================================

# JWT 签名密钥（生产必须设置强随机值！如：openssl rand -hex 32）
JWT_SECRET=your_jwt_secret_here_change_me

# CSRF 显式配置（可选）
# 受信第三方 Origin（逗号分隔，如小程序 WebView/反向代理域）；默认仅同源
# CSRF_TRUSTED_ORIGINS=https://miniapp.example,https://admin.example
# 严格模式：Cookie 写请求缺失 Origin 头即拒绝（默认 false——放行无 Origin 的非浏览器客户端）
# CSRF_REQUIRE_ORIGIN=false
# 访问令牌有效期（默认 7d）
JWT_EXPIRES_IN=7d
# 刷新令牌有效期（默认 30d）
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# 日志体系（P0-2 Winston）
# ===========================================

# 日志级别（debug | info | warn | error；生产建议 info）
LOG_LEVEL=info
# 日志输出目录（默认 logs/，已 gitignore）
LOG_DIR=logs/

# 错误上报 Slack 通知（可选，配置后 /api/error-report 会推送）
SLACK_WEBHOOK_URL=

# ===========================================
# 已弃用 / 未接入项（保留仅为历史兼容，不影响运行）
# ===========================================

# 存储：当前使用 SQLite（node:sqlite，落盘 data/yyc3.db），
# 以下外部存储均未接入：Supabase / PostgreSQL / Redis / AWS S3 / Firebase
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...
# AWS_S3_BUCKET=...
# FIREBASE_PROJECT_ID=...

# 监控：Vercel Analytics + Speed Insights 已接入（app/layout.tsx，Vercel 部署即生效）；
# Sentry / Google Analytics 未接入
# NEXT_PUBLIC_SENTRY_DSN=...
# NEXT_PUBLIC_GA_ID=...
